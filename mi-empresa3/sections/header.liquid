{% comment %}Header - NANO Premium v5.0{% endcomment %}

{%- assign featured_collection = collections[section.settings.featured_collection] -%}
{%- assign category_menu = linklists[section.settings.category_menu] -%}

<header class="site-header site-header--premium" role="banner">
  <div class="site-header__row">
    <div class="site-header__left">
      <button class="mobile-menu-btn" aria-label="Abrir menu" aria-controls="mobile-menu" aria-expanded="false">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>

      <a href="/" class="site-header__logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 320 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width | default: 130 }}"
            height="44"
            loading="eager"
          >
        {%- else -%}
          <span class="site-header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="site-header__search">
      <input type="search" name="q" placeholder="Buscar iPhone, MacBook, AirPods..." aria-label="Buscar productos">
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="Buscar">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
    </form>

    <div class="site-header__actions">
      <a href="{{ routes.account_url }}" class="site-header__icon-btn" aria-label="Mi cuenta">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 20c2.2-3 5-4.5 8-4.5s5.8 1.5 8 4.5"></path>
        </svg>
      </a>
      <button class="cart-toggle-btn" aria-label="Abrir carrito" aria-haspopup="dialog">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="site-header__cart-label">Carrito</span>
        <span class="site-header__cart-badge" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <nav class="site-nav" aria-label="Navegacion principal">
    <ul class="site-nav__list">
      <li class="site-nav__item"><a href="/">Inicio</a></li>
      <li class="site-nav__item site-nav__item--mega">
        <button type="button" class="site-nav__trigger" aria-expanded="false">Categorias</button>
        <div class="mega-menu" role="region" aria-label="Mega menu de categorias">
          <div class="mega-menu__columns">
            {%- if category_menu != blank and category_menu.links.size > 0 -%}
              {%- for link in category_menu.links limit: 4 -%}
                <div class="mega-menu__col">
                  <a href="{{ link.url }}" class="mega-menu__title">{{ link.title }}</a>
                  {%- if link.links.size > 0 -%}
                    <ul>
                      {%- for child in link.links limit: 5 -%}
                        <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="mega-menu__col">
                <a href="/collections/computadores" class="mega-menu__title">Computadores</a>
                <ul><li><a href="/collections/laptops">Laptops</a></li><li><a href="/collections/gaming">Gaming</a></li></ul>
              </div>
              <div class="mega-menu__col">
                <a href="/collections/celulares" class="mega-menu__title">Celulares</a>
                <ul><li><a href="/collections/iphone">iPhone</a></li><li><a href="/collections/android">Android</a></li></ul>
              </div>
              <div class="mega-menu__col">
                <a href="/collections/audio" class="mega-menu__title">Audio</a>
                <ul><li><a href="/collections/audifonos">Audifonos</a></li><li><a href="/collections/parlantes">Parlantes</a></li></ul>
              </div>
              <div class="mega-menu__col">
                <a href="/collections/accesorios" class="mega-menu__title">Accesorios</a>
                <ul><li><a href="/collections/cables">Cables</a></li><li><a href="/collections/cargadores">Cargadores</a></li></ul>
              </div>
            {%- endif -%}
          </div>
          <div class="mega-menu__highlight">
            {%- if section.settings.featured_image != blank -%}
              <img src="{{ section.settings.featured_image | image_url: width: 640 }}" alt="{{ section.settings.featured_title | escape }}" loading="lazy">
            {%- endif -%}
            <p class="mega-menu__eyebrow">{{ section.settings.featured_eyebrow | default: 'Destacado' }}</p>
            <h3>{{ section.settings.featured_title | default: 'Tecnologia premium para Colombia' }}</h3>
            <a href="{{ section.settings.featured_url | default: '/collections/all' }}">{{ section.settings.featured_cta | default: 'Comprar ahora' }}</a>
          </div>
        </div>
      </li>
      <li class="site-nav__item"><a href="/collections/all">Catalogo</a></li>
      <li class="site-nav__item"><a href="/pages/financiacion">Financiacion</a></li>
      <li class="site-nav__item"><a href="/pages/soporte">Soporte</a></li>
      {%- if section.settings.whatsapp_number != blank -%}
        <li class="site-nav__item"><a href="https://wa.me/{{ section.settings.whatsapp_number }}" target="_blank" rel="noopener">WhatsApp</a></li>
      {%- endif -%}
    </ul>
  </nav>
</header>

<div class="mobile-menu__backdrop" id="mobile-backdrop"></div>
<nav id="mobile-menu" class="mobile-menu mobile-menu--premium" aria-label="Menu movil" aria-hidden="true">
  <button class="mobile-menu__close" aria-label="Cerrar menu">&times;</button>
  <div class="mobile-menu__search-wrap">
    <form action="{{ routes.search_url }}" method="get" role="search" class="mobile-menu__search">
      <input type="search" name="q" placeholder="Buscar productos..." aria-label="Buscar productos">
      <input type="hidden" name="type" value="product">
    </form>
  </div>
  <div class="mobile-menu__nav">
    <a href="/" class="mobile-menu__link">Inicio</a>
    <button type="button" class="mobile-menu__accordion-btn" aria-expanded="false">
      Categorias
      <span>+</span>
    </button>
    <div class="mobile-menu__accordion-panel" hidden>
      <a href="/collections/computadores" class="mobile-menu__sublink">Computadores</a>
      <a href="/collections/celulares" class="mobile-menu__sublink">Celulares</a>
      <a href="/collections/tablets" class="mobile-menu__sublink">Tablets</a>
      <a href="/collections/audio" class="mobile-menu__sublink">Audio</a>
      <a href="/collections/accesorios" class="mobile-menu__sublink">Accesorios</a>
    </div>
    <a href="/collections/all" class="mobile-menu__link">Catalogo</a>
    <a href="{{ routes.account_url }}" class="mobile-menu__link">Mi cuenta</a>
    <a href="/cart" class="mobile-menu__link">Carrito ({{ cart.item_count }})</a>
    {%- if section.settings.whatsapp_number != blank -%}
      <a href="https://wa.me/{{ section.settings.whatsapp_number }}" class="mobile-menu__link" target="_blank" rel="noopener">Asesoria por WhatsApp</a>
    {%- endif -%}
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Ancho del logo (px)",
      "min": 60,
      "max": 260,
      "step": 10,
      "default": 120
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Menu de categorias (desktop)"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Numero WhatsApp (sin +)",
      "placeholder": "573001234567"
    },
    {
      "type": "header",
      "content": "Destacado del mega menu"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Imagen destacada"
    },
    {
      "type": "text",
      "id": "featured_eyebrow",
      "label": "Texto superior",
      "default": "NUEVO"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Titulo destacado",
      "default": "Estrena lo ultimo en tecnologia"
    },
    {
      "type": "text",
      "id": "featured_cta",
      "label": "Texto CTA",
      "default": "Ver promociones"
    },
    {
      "type": "url",
      "id": "featured_url",
      "label": "URL CTA"
    }
  ]
}
{% endschema %}
